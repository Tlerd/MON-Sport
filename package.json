{
  "name": "monsport",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "db:start": "node scripts/db-local.mjs",
    "dev:api": "pnpm --filter @monsport/api dev",
    "dev:web": "pnpm --filter @monsport/web dev",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.6.0",
    "playwright-core": "1.64.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
