{
  "model": "opusplan",
  "permissions": {
    "defaultMode": "plan"
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": true,
    "ba-kit@ba-kit": true
  },
  "extraKnownMarketplaces": {
    "ba-kit": {
      "source": {
        "source": "github",
        "repo": "Tlerd/BA-Microsoft"
      }
    }
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/check.mjs", "--hook"],
            "timeout": 300
          }
        ]
      }
    ]
  }
}
