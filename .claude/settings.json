{
  "model": "opus",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(gcloud *)",
      "Bash(agy *)",
      "Bash(curl *)",
      "PowerShell(pnpm *)",
      "PowerShell(node *)",
      "PowerShell(git *)",
      "PowerShell(gh *)",
      "PowerShell(gcloud *)",
      "PowerShell(agy *)",
      "PowerShell(curl *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push *:main*)",
      "Bash(git push origin main*)",
      "Bash(git push -u origin main*)",
      "Bash(git push --set-upstream*main*)",
      "Bash(git push * --delete*)",
      "Bash(git push --mirror*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git reflog expire*)",
      "Bash(git update-ref -d*)",
      "Bash(gh pr merge --admin*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit --visibility*)",
      "Bash(gh repo archive*)",
      "Bash(gh release delete*)",
      "Bash(gh issue delete*)",
      "Bash(gh label delete*)",
      "Bash(gh run delete*)",
      "Bash(gh secret delete*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api --method DELETE*)",
      "Bash(gh api * --method DELETE*)",
      "Bash(gcloud * delete*)",
      "Bash(gcloud secrets versions access*)",
      "Bash(gcloud sql users set-password*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(git push *:main*)",
      "PowerShell(git push origin main*)",
      "PowerShell(git push -u origin main*)",
      "PowerShell(git push --set-upstream*main*)",
      "PowerShell(git push * --delete*)",
      "PowerShell(git push --mirror*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean*)",
      "PowerShell(git reflog expire*)",
      "PowerShell(git update-ref -d*)",
      "PowerShell(gh pr merge --admin*)",
      "PowerShell(gh pr merge * --admin*)",
      "PowerShell(gh repo delete*)",
      "PowerShell(gh repo edit --visibility*)",
      "PowerShell(gh repo archive*)",
      "PowerShell(gh release delete*)",
      "PowerShell(gh issue delete*)",
      "PowerShell(gh label delete*)",
      "PowerShell(gh run delete*)",
      "PowerShell(gh secret delete*)",
      "PowerShell(gh api -X DELETE*)",
      "PowerShell(gh api * -X DELETE*)",
      "PowerShell(gh api --method DELETE*)",
      "PowerShell(gh api * --method DELETE*)",
      "PowerShell(gcloud * delete*)",
      "PowerShell(gcloud secrets versions access*)",
      "PowerShell(gcloud sql users set-password*)"
    ]
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": true,
    "ba-kit@ba-kit": true
  },
  "extraKnownMarketplaces": {
    "ba-kit": {
      "source": {
        "source": "github",
        "repo": "Tlerd/BA-Microsoft"
      }
    }
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/check.mjs",
              "--hook"
            ],
            "timeout": 300
          }
        ]
      }
    ]
  }
}
