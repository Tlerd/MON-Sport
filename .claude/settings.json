{
  "model": "opus",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pnpm check*)",
      "Bash(pnpm install*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm db:start*)",
      "Bash(node scripts/*)",
      "Bash(git *)",
      "Bash(gh *)",
      "PowerShell(pnpm check*)",
      "PowerShell(pnpm install*)",
      "PowerShell(pnpm dev:*)",
      "PowerShell(pnpm db:start*)",
      "PowerShell(node scripts/*)",
      "PowerShell(git *)",
      "PowerShell(gh *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push *:main*)",
      "Bash(git push origin main*)",
      "Bash(git push -u origin main*)",
      "Bash(git push --set-upstream*main*)",
      "Bash(git push * --delete*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git checkout -- .*)",
      "Bash(git restore .*)",
      "Bash(gh pr merge --admin*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo archive*)",
      "Bash(gh release delete*)",
      "Bash(gh secret*)",
      "Bash(gh issue delete*)",
      "Bash(gh label delete*)",
      "Bash(gh run delete*)",
      "Bash(gh api -X*)",
      "Bash(gh api --method*)",
      "Bash(gcloud *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(git push *:main*)",
      "PowerShell(git push origin main*)",
      "PowerShell(git push -u origin main*)",
      "PowerShell(git push --set-upstream*main*)",
      "PowerShell(git push * --delete*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git stash drop*)",
      "PowerShell(git stash clear*)",
      "PowerShell(git checkout -- .*)",
      "PowerShell(git restore .*)",
      "PowerShell(gh pr merge --admin*)",
      "PowerShell(gh pr merge * --admin*)",
      "PowerShell(gh repo delete*)",
      "PowerShell(gh repo edit*)",
      "PowerShell(gh repo archive*)",
      "PowerShell(gh release delete*)",
      "PowerShell(gh secret*)",
      "PowerShell(gh issue delete*)",
      "PowerShell(gh label delete*)",
      "PowerShell(gh run delete*)",
      "PowerShell(gh api -X*)",
      "PowerShell(gh api --method*)",
      "PowerShell(gcloud *)"
    ]
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": true,
    "ba-kit@ba-kit": true
  },
  "extraKnownMarketplaces": {
    "ba-kit": {
      "source": {
        "source": "github",
        "repo": "Tlerd/BA-Microsoft"
      }
    }
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/check.mjs",
              "--hook"
            ],
            "timeout": 300
          }
        ]
      }
    ]
  }
}
