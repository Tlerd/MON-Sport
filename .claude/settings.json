{
  "model": "opus",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pnpm *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(node *)",
      "Bash(agy *)",
      "PowerShell(pnpm *)",
      "PowerShell(git *)",
      "PowerShell(gh *)",
      "PowerShell(node *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git reset --hard*)",
      "Bash(gh pr merge --admin*)",
      "Bash(gh repo delete*)",
      "Bash(gcloud *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push origin main*)",
      "PowerShell(gcloud *)"
    ]
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": true,
    "ba-kit@ba-kit": true
  },
  "extraKnownMarketplaces": {
    "ba-kit": {
      "source": {
        "source": "github",
        "repo": "Tlerd/BA-Microsoft"
      }
    }
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/check.mjs",
              "--hook"
            ],
            "timeout": 300
          }
        ]
      }
    ]
  }
}
