# === Database (Postgres, chay qua Docker local trong dev) ===
POSTGRES_USER=monsport
POSTGRES_PASSWORD=monsport
POSTGRES_DB=monsport
POSTGRES_PORT=5432
# Dung boi docker-compose + Prisma. Doi sang connection string Supabase khi deploy.
DATABASE_URL="postgresql://monsport:monsport@localhost:5432/monsport?schema=public"

# === API (NestJS) ===
# Cong API lang nghe. Swagger se o http://localhost:<PORT>/api/docs
PORT=3000
# Origin cua web dev server (Vite), dung de bat CORS o api.
CORS_ORIGIN="http://localhost:5173"
# Doi chuoi nay truoc khi len production. Dung de ky JWT dang nhap.
JWT_SECRET="doi-chuoi-nay-truoc-khi-len-production"
JWT_EXPIRES_IN="7d"

# === Ba cong doi duoc (xem docs/PROMPT.md muc 1.3) ===
# Ban demo nay chua co dich vu ngoai that, luon dung ban mock/local:
AUTH_PROVIDER=mock
NOTIFICATION_ADAPTER=console
FILE_STORAGE_ADAPTER=local
UPLOAD_DIR=./uploads
