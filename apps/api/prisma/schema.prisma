// Names follow docs/requirements/data-dictionary.md. Brief F-002 adds User, Venue, Court, and Booking. Brief F-003 adds User.consentAt.
// Brief F-004 adds User.googleSub, User.email, User.phoneVerifiedAt, nullable passwordHash, PhoneOtp, and DevOtpOutbox.
// Brief F-006 adds User.sessionsValidFrom and AuthThrottle. Brief F-011 adds Match and MatchPlayer. Brief F-013 adds Notification.
// Brief F-014 adds PushSubscription and Notification.pushedAt.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OWNER
  USER
}

enum NotificationType {
  BOOKING_REQUESTED
  BOOKING_CONFIRMED
  BOOKING_REJECTED
  MATCH_CANCELLED
}

enum Sport {
  FOOTBALL
  BADMINTON
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
  CANCELLED
}

enum BookingSource {
  APP
  PHONE
}

enum MatchStatus {
  OPEN
  FULL
  CANCELLED
  FINISHED
}

enum MatchPlayerStatus {
  ACTIVE
  LEFT
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String    @db.VarChar(100)
  phone           String    @unique @db.VarChar(10)
  passwordHash    String?   @db.VarChar(200)
  role            Role      @default(USER)
  googleSub       String?   @unique @db.VarChar(255)
  email           String?   @db.VarChar(254)
  phoneVerifiedAt DateTime? @db.Timestamptz(3)
  lockedAt        DateTime? @db.Timestamptz(3)
  deletedAt       DateTime? @db.Timestamptz(3)
  /// When the user agreed to the privacy notice at sign-up. Null for accounts that an admin or the seed created.
  consentAt       DateTime? @db.Timestamptz(3)
  /// The session guard refuses a cookie issued before this time. The admin unlock sets it. Null: no limit.
  sessionsValidFrom DateTime? @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  venues          Venue[]
  bookings        Booking[]
  matches         Match[]
  matchPlayers    MatchPlayer[]
  notifications   Notification[]
  pushSubscriptions PushSubscription[]
}

model Venue {
  id       String  @id @default(uuid(7)) @db.Uuid
  ownerId  String  @db.Uuid
  name     String  @db.VarChar(100)
  address  String  @db.VarChar(200)
  phone    String  @db.VarChar(10)
  /// Minutes since 00:00, a multiple of 30.
  opensAt  Int
  /// Minutes since 00:00, a multiple of 30, after opensAt.
  closesAt Int
  owner    User    @relation(fields: [ownerId], references: [id])
  courts   Court[]
}

model Court {
  id          String    @id @default(uuid(7)) @db.Uuid
  venueId     String    @db.Uuid
  name        String    @db.VarChar(50)
  sport       Sport
  priceNormal Int
  pricePeak   Int
  venue       Venue     @relation(fields: [venueId], references: [id])
  bookings    Booking[]

  @@unique([venueId, name])
}

model Booking {
  id              String        @id @default(uuid(7)) @db.Uuid
  courtId         String        @db.Uuid
  startAt         DateTime      @db.Timestamptz(3)
  endAt           DateTime      @db.Timestamptz(3)
  status          BookingStatus
  source          BookingSource
  createdById     String        @db.Uuid
  customerName    String?       @db.VarChar(100)
  customerPhone   String?       @db.VarChar(10)
  priceTotal      Int
  paidAtVenue     Boolean       @default(false)
  confirmDeadline DateTime?     @db.Timestamptz(3)
  confirmedAt     DateTime?     @db.Timestamptz(3)
  cancelledAt     DateTime?     @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  court           Court         @relation(fields: [courtId], references: [id])
  createdBy       User          @relation(fields: [createdById], references: [id])
  match           Match?
  notifications   Notification[]

  @@index([courtId, status])
  @@index([createdById])
  @@index([courtId, startAt])
}

model Match {
  id           String        @id @default(uuid(7)) @db.Uuid
  bookingId    String        @unique @db.Uuid
  hostId       String        @db.Uuid
  sport        Sport
  capacity     Int
  pricePerSlot Int
  status       MatchStatus   @default(OPEN)
  joinedCount  Int
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  booking      Booking       @relation(fields: [bookingId], references: [id])
  host         User          @relation(fields: [hostId], references: [id])
  players      MatchPlayer[]
  notifications Notification[]

  @@index([status, sport])
  @@index([hostId])
}

model MatchPlayer {
  matchId  String            @db.Uuid
  userId   String            @db.Uuid
  status   MatchPlayerStatus
  joinedAt DateTime          @db.Timestamptz(3)
  leftAt   DateTime?         @db.Timestamptz(3)
  match    Match             @relation(fields: [matchId], references: [id])
  user     User              @relation(fields: [userId], references: [id])

  @@id([matchId, userId])
  @@index([userId, status])
}

/// A fixed-window counter of login or sign-up attempts (brief F-006, BR-30). Both Cloud Run instances share it.
/// The key is "<counter>:<HMAC-SHA256 of the phone or the IP>", so the table holds no readable phone or IP.
model AuthThrottle {
  key         String   @id @db.VarChar(100)
  count       Int
  windowStart DateTime @db.Timestamptz(3)

  @@index([windowStart])
}

/// Brief F-013 (UC-14): In-app notifications. Names follow docs/requirements/data-dictionary.md.
model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  bookingId String           @db.Uuid
  matchId   String?          @db.Uuid
  readAt    DateTime?        @db.Timestamptz(3)
  /// Brief F-014: when an API instance claimed the row for Web Push. Null: not sent yet. Rows older than the migration hold createdAt.
  pushedAt  DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  user      User             @relation(fields: [userId], references: [id])
  booking   Booking          @relation(fields: [bookingId], references: [id])
  match     Match?           @relation(fields: [matchId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}

/// Brief F-014 (UC-14): one device that receives Web Push. The endpoint is unique, so a browser belongs to one user (Assumption 2).
/// It is personal data of the device: delete the row when the user unsubscribes or the push service answers 404 or 410.
model PushSubscription {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique @db.VarChar(2048)
  p256dh    String   @db.VarChar(200)
  auth      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

/// Brief F-004: Phone verification OTP codes (O2). Only HMAC-SHA256 digests are stored.
model PhoneOtp {
  phoneKey  String   @db.VarChar(64)
  purpose   String   @db.VarChar(30)
  codeHash  String   @db.Char(64)
  attempts  Int      @default(0)
  sentAt    DateTime @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)

  @@id([phoneKey, purpose])
  @@index([expiresAt])
}

/// Brief F-004: Dev-only outbox for OTP codes when OTP_PROVIDER is "dev". Empty in production.
model DevOtpOutbox {
  id        String   @id @default(uuid(7)) @db.Uuid
  phone     String   @db.VarChar(10)
  code      String   @db.Char(6)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}


