# Copy to .env. `pnpm db:start` creates this role and these databases.
DATABASE_URL=postgresql://monsport:monsport@localhost:55432/monsport_dev
PORT=3000
# Signs the session cookie. Set a long random value in production.
SESSION_SECRET=local-development-only
# Web Push (brief F-014). Empty values turn the feature off. `npx web-push generate-vapid-keys` makes a key pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# How long the API waits for a push service, in milliseconds.
PUSH_TIMEOUT_MS=10000
# OTP sender provider: 'esms' on Cloud Run, 'dev' locally.
OTP_PROVIDER=
# Maximum OTP messages sent per day across the system (default 200).
OTP_DAILY_CAP=
# API key for the eSMS service.
ESMS_API_KEY=
# Secret key for the eSMS service.
ESMS_SECRET_KEY=
# Registered SMS brandname for the eSMS service.
ESMS_BRANDNAME=
# Google OIDC (brief F-004). Empty values disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Public origin of the API for OAuth (brief F-038), for example https://monsport.example. Empty turns the OAuth routes off.
PUBLIC_ORIGIN=
# Hosts allowed as OAuth client_id (CIMD), comma separated. Default: claude.ai.
OAUTH_CIMD_HOSTS=claude.ai
